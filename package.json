{
  "name": "ltijs-sequelize",
  "version": "3.0.0",
  "description": "Ltijs Sequelize Database Plugin",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "engineStrict": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "build:clean": "del-cli dist",
    "build:compile": "tsc -p tsconfig.build.json",
    "build": "npm-run-all build:clean build:compile",
    "check:format": "prettier . --write",
    "check:lint": "eslint src",
    "check:tests:unit": "jest -c jest.config.ts",
    "check:tests:db": "jest -c jest.dbconfig.ts --runInBand",
    "test": "npm-run-all check:format check:lint check:tests:unit check:tests:db",
    "deploy:beta": "npm-run-all test build && npm publish --tag beta",
    "deploy": "npm-run-all test build && npm publish"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,md}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cvmcosta/ltijs-sequelize.git"
  },
  "keywords": [
    "ltijs",
    "lti",
    "postgresql",
    "postgres",
    "mysql",
    "sequelize",
    "provider",
    "ims"
  ],
  "author": "cvmcosta",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Cvmcosta/ltijs-sequelize/issues"
  },
  "homepage": "https://github.com/Cvmcosta/ltijs-sequelize#readme",
  "peerDependencies": {
    "ltijs": "^7.0.0",
    "mariadb": "^2.0.0 || ^3.0.0",
    "mysql2": "^2.0.0 || ^3.0.0",
    "pg": "^8.0.0",
    "pg-hstore": "^2.0.0",
    "tedious": "^11.0.0 || ^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0"
  },
  "peerDependenciesMeta": {
    "mariadb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "pg-hstore": {
      "optional": true
    },
    "tedious": {
      "optional": true
    }
  },
  "dependencies": {
    "debug": "^4.4.3",
    "node-cron": "^3.0.3",
    "sequelize": "^6.37.7",
    "umzug": "^3.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/node-cron": "^3.0.11",
    "del-cli": "^7.0.0",
    "eslint": "^9.12.0",
    "eslint-config-love": "^85.0.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "lint-staged": "^17.5.0",
    "ltijs": "file:../ltijs",
    "npm-run-all": "^4.1.5",
    "prettier": "3.9.6",
    "sqlite3": "^5.1.7",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true
  }
}
